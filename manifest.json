{
  "version": 1,
  "external": [
    "agterm"
  ],
  "entries": [
    {
      "id": "skill/task-plan",
      "method": "symlink",
      "source": "codex/skills/task-plan",
      "targets": [
        "~/.agents/skills/task-plan"
      ]
    },
    {
      "id": "skill/plan",
      "method": "symlink",
      "source": "claude/skills/plan",
      "targets": [
        "~/.claude/skills/plan"
      ]
    },
    {
      "id": "skill/claude-review",
      "method": "symlink",
      "source": "codex/skills/claude-review",
      "targets": [
        "~/.agents/skills/claude-review"
      ]
    },
    {
      "id": "skill/codex-review",
      "method": "symlink",
      "source": "claude/skills/codex-review",
      "targets": [
        "~/.claude/skills/codex-review"
      ]
    },
    {
      "id": "skill/commit-me",
      "method": "symlink",
      "source": "shared/skills/commit-me",
      "targets": [
        "~/.agents/skills/commit-me",
        "~/.claude/skills/commit-me"
      ]
    },
    {
      "id": "skill/backlog",
      "method": "symlink",
      "source": "claude/skills/backlog",
      "targets": [
        "~/.claude/skills/backlog"
      ]
    },
    {
      "id": "skill/codex/backlog",
      "method": "symlink",
      "source": "codex/skills/backlog",
      "targets": [
        "~/.agents/skills/backlog"
      ]
    },
    {
      "id": "skill/peer-chat",
      "method": "symlink",
      "source": "claude/skills/peer-chat",
      "targets": [
        "~/.claude/skills/peer-chat"
      ],
      "requires": {
        "commands": [
          "peer-chat.py"
        ]
      }
    },
    {
      "id": "skill/codex/peer-chat",
      "method": "symlink",
      "source": "codex/skills/peer-chat",
      "targets": [
        "~/.agents/skills/peer-chat"
      ],
      "requires": {
        "commands": [
          "peer-chat.py"
        ]
      }
    },
    {
      "id": "instructions/claude",
      "method": "symlink",
      "source": "claude/CLAUDE.md",
      "targets": [
        "~/.claude/CLAUDE.md"
      ]
    },
    {
      "id": "instructions/shared-claude",
      "method": "symlink",
      "source": "shared/instructions.md",
      "targets": [
        "~/.claude/rules/shared.md"
      ]
    },
    {
      "id": "instructions/codex",
      "method": "compose",
      "sources": [
        "shared/instructions.md",
        "codex/instructions.md"
      ],
      "targets": [
        "~/.codex/AGENTS.md"
      ]
    }
  ]
}
